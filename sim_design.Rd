\name{sim_design}
\alias{sim_design}
\title{Simulate Data from the Seven Simulation Designs}
\description{
Generates one sample from any of the seven simulation designs of the paper.
}
\usage{
sim_design(design, n, delta = NULL,
           alternative = c("null", "local"),
           family = c("hypercube", "overlap"),
           signs = c(1, 1), seed = NULL)
}
\arguments{
  \item{design}{integer from 1 to 7; see \code{\link{design_setup}}.}
  \item{n}{sample size.}
  \item{delta}{window length; used only in design 3.}
  \item{alternative}{design 6 only: \code{"null"} for the zero operator, or
    \code{"local"} for the local alternative \eqn{H/\sqrt{n}}.}
  \item{family}{design 7 only: \code{"hypercube"} for the disjoint cubic
    family \{1,2,3\}, \{4,5,6\}, or \code{"overlap"} for \{1,3\},
    \{1,2,3\}.}
  \item{signs}{design 7 only: the signs \eqn{(\sigma_1, \sigma_2)}.}
  \item{seed}{optional random seed.}
}
\details{
The data are generated by \code{\link{gen_fofr}}. Training and test samples
are obtained by calling the function twice with different seeds. The
settings actually used, including the true operator, are stored in
\code{setup}.
}
\value{
An object of class \code{"rbdata"} with the extra components \code{truth}
(see \code{\link{gen_fofr}}) and \code{setup} (see
\code{\link{design_setup}}). The true index sets and coefficients are
\code{setup$J} and \code{setup$Gamma}.
}
\seealso{\code{\link{design_setup}}, \code{\link{rbfit}},
\code{\link{evaluate_fit}}}
\examples{
\dontrun{
## Design 1: resolvable nonlinear effects
train <- sim_design(1, n = 500, seed = 1)
test <- sim_design(1, n = 1000, seed = 2)
fit <- rbfit(train, qmax = 2)
evaluate_fit(fit, test, train$setup$J, train$setup$Gamma)

## Design 3: operator loss and fragment-signal loss across window lengths
for (dl in c(0.22, 0.38, 1)) {
  tr <- sim_design(3, n = 1000, delta = dl, seed = 3)
  te <- sim_design(3, n = 1000, delta = dl, seed = 4)
  f <- rbfit(tr, qmax = 3)
  print(round(evaluate_fit(f, te, tr$setup$J, tr$setup$Gamma)[
    c("operator_total", "operator_nonresolvable", "fragment_signal_mse")], 3))
}

## Design 4: Gaussian scores; the omitted cubic energy 2.5 remains
dat <- sim_design(4, n = 2000, seed = 5)
err <- operator_error(rbfit(dat, qmax = 3), dat$setup$J, dat$setup$Gamma)
c(total = err$total, estimated = err$estimated,
  omitted = err$nonresolvable)

## Design 6: local alternative H / sqrt(n)
dat <- sim_design(6, n = 1600, alternative = "local", seed = 6)

## Design 7: overlapping family with opposite signs
dat <- sim_design(7, n = 30000, family = "overlap",
                  signs = c(1, -1), seed = 7)
}
}
\keyword{datagen}
